{
  "manifest_version": 3,
  "name": "Outtask",
  "description": "Persian midnight task manager — Jalali calendar with JSON occasions, folder tasks, 24h colored time tracking, bullet-journal habit tracker, Gemini AI assistant with hatched time planning, and repeating alarms. Minimal Linear design.",
  "version": "2.8.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Outtask",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage","unlimitedStorage","notifications","alarms","tabs","scripting","offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-eye-care.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*","icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
